<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>

    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>

  <body>
    <main>
      <h1><%= title %></h1>

      <a href="/new">Write a new message</a>

      <section class="messages">
        <% messages.forEach((message) => { %>
          <article class="message">
            <h2><%= message.user %></h2>
            <p><%= message.text %></p>
            <time><%= message.added.toLocaleString() %></time>
          </article>
        <% }); %>
      </section>
    </main>
  </body>
</html>